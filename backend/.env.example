# CampusHub backend environment — variable reference.
# Copy to .env for local development and fill in real values.
# NEVER commit real secrets. Production values must come from the host
# secrets manager (Render dashboard / Vercel env / container env).

# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campushub_dev

# JWT (required; min 32 random chars in production — enforced at startup)
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=30d

# Session (required; same rules as JWT_SECRET — enforced at startup)
SESSION_SECRET=

# Frontend origin(s), comma-separated (required in production; enforced at startup)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP app password from the mail provider; never commit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=CampusHub
ENABLE_MOCK_EMAIL=true

# Payments (mock mode is REFUSED in production — enforced at startup)
ENABLE_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cache (optional; in-memory fallback is used when unset)
REDIS_URL=

# Misc
BCRYPT_ROUNDS=10
