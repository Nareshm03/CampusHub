# CampusHub backend environment — variable reference.
# Copy to .env for local development and fill in real values.
# NEVER commit real secrets. Production values must come from the host
# secrets manager (Render dashboard / Vercel env / container env).

# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campushub_dev

# JWT (required; min 32 random chars in production — enforced at startup)
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=30d

# Session (required; same rules as JWT_SECRET — enforced at startup)
SESSION_SECRET=

# Frontend origin(s), comma-separated (required in production; enforced at startup)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP app password from the mail provider; never commit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=CampusHub
ENABLE_MOCK_EMAIL=true

# Payments (mock mode is REFUSED in production — enforced at startup)
ENABLE_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cache (optional; in-memory fallback is used when unset)
REDIS_URL=

# Misc
BCRYPT_ROUNDS=10

# File storage (local dev/tests default; Azure staging uses "azure")
# local  -> <backend>/uploads/<category>/ served only through authorized API
#           routes (never express.static).
# azure  -> ONE private container; blob name "<category>/<filename>".
#           Auth is DefaultAzureCredential (Container App managed identity in
#           Azure; Azure CLI/VS Code credentials for local operators). No
#           connection string or storage key is required or read. When "azure"
#           is selected without a reachable account/container, file operations
#           fail closed with 503/502 — there is no silent local fallback.
FILE_STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=campushub-private

# Storage safety: application-side upload guard, NOT an account-wide billing
# cap. Default 4,000,000,000 bytes (~3.73 GiB) keeps headroom below the ~5 GB
# student free allowance. Breaching it fails uploads with HTTP 413; nothing
# auto-upgrades. Monitor real transaction/egress usage in Azure Cost
# Management. STORAGE_MAX_BYTES override is honored when set.
STORAGE_MAX_BYTES=4000000000
STORAGE_WARN_BYTES=3200000000
# Optional global per-file ceiling (bytes). Only tightens the per-category
# caps, never loosens them. Unset by default.
# UPLOAD_MAX_FILE_BYTES=
