# Backend Production Environment Variables
PORT=10000
NODE_ENV=production

# Database - Use production database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/campushub_prod?retryWrites=true&w=majority

# JWT Configuration - Generate strong secrets
JWT_SECRET=generate_a_strong_random_secret_here
JWT_EXPIRE=30d

# Session Configuration
SESSION_SECRET=generate_another_strong_random_secret_here

# Frontend URL - must exactly match the deployed frontend origin
FRONTEND_URL=REPLACE_WITH_PRODUCTION_FRONTEND_URL
ALLOWED_ORIGINS=REPLACE_WITH_PRODUCTION_FRONTEND_URL

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=CampusHub
ENABLE_MOCK_EMAIL=false

# Payment Configuration - mock mode is REFUSED in production (enforced at startup)
ENABLE_MOCK_PAYMENTS=false
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
